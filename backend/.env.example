# Copiar como .env (desarrollo local) o como /etc/acortador.env (EC2)
AWS_REGION=us-east-1
TABLE_NAME=short_links
# IP pública o dominio del backend en EC2
BASE_URL=http://<ip-publica-ec2>:8000
# URL del sitio web en S3 (sin barra final). Varios orígenes separados por comas.
ALLOWED_ORIGINS=http://<nombre-bucket>.s3-website-us-east-1.amazonaws.com
