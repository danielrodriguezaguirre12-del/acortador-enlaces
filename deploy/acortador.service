[Unit]
Description=Acortador de enlaces (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/acortador-enlaces/backend
EnvironmentFile=/etc/acortador.env
ExecStart=/home/ec2-user/acortador-enlaces/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
